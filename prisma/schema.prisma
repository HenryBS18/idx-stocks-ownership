generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Info {
  id             Int      @id @default(autoincrement()) @db.Integer()
  idxLastUpdated String   @db.VarChar(26)
  month          Int      @db.Integer
  year           Int      @db.Integer
  createdAt      DateTime @default(now()) @db.Timestamptz(0)

  stockInvestor StockInvestor[]

  @@index([year, month])
}

enum Sector {
  BASIC_MAT       @map("Basic Mat")
  CYCLICAL        @map("Cyclical")
  ENERGY          @map("Energy")
  FINANCE         @map("Finance")
  HEALTH          @map("Health")
  INDUSTRIAL      @map("Industrial")
  INFRASTRUCTURES @map("Infrastructures")
  NON_CYCLICAL    @map("Non-Cyclical")
  PROPERTY        @map("Property")
  TECHNOLOGY      @map("Technology")
  TRANSPORT       @map("Transport")
}

model Stock {
  ticker String  @id @db.Char(4)
  name   String  @db.VarChar(60)
  sector Sector?

  hscConcentration Decimal? @db.Decimal(5, 3)

  stockInvestor StockInvestor[]
}

model HscInfo {
  id         Int      @id @default(1) @db.Integer
  announceAt DateTime @db.Date
  updatedAt  DateTime @updatedAt @db.Timestamptz(0)
}

model InvestorProfile {
  investorName String @id @db.VarChar(150)
  slug         String @unique @db.VarChar(220)
}

enum ControllerOrAffiliate {
  CONTROLLER
  AFFILIATE
}

model StockInvestor {
  id                    Int                    @id @default(autoincrement()) @db.Integer()
  ticker                String                 @db.Char(4)
  investorName          String                 @db.VarChar(150)
  investorType          String                 @db.VarChar(100)
  controllerOrAffiliate ControllerOrAffiliate?
  localForeign          String                 @db.Char(1)
  domicile              String                 @db.VarChar(100)
  scripless             BigInt                 @db.BigInt()
  scrip                 BigInt                 @db.BigInt()
  totalHoldingShare     BigInt                 @db.BigInt()
  percentage            Decimal                @db.Decimal(5, 2)
  infoId                Int                    @db.Integer

  stock Stock @relation(fields: [ticker], references: [ticker])
  info  Info  @relation(fields: [infoId], references: [id])

  @@index([infoId, ticker])
  @@index([investorName, infoId])
}
